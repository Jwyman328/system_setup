{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"chrome-devtools": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"chrome-devtools-mcp@latest"
			],
			"enabled": true,
		}
	},
	"tools": {
		"chrome-devtools": false
	},
	"agent": {
		"web-tester": {
			"description": "Agent specialized in web testing and browser automation",
			"tools": {
				"chrome-devtools*": true // Enable all Chrome DevTools MCP tools for this agent
			}
		},
	}
}
