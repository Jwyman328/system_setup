{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"chrome-devtools": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"chrome-devtools-mcp@latest"
			],
			"enabled": true,
		}
	},
	"tools": {
		"chrome-devtools": false
	},
	"agent": {
		"web-tester": {
			"description": "Agent specialized in web testing and browser automation",
			"tools": {
				"chrome-devtools*": true // Enable all Chrome DevTools MCP tools for this agent
			}
		},
		"frontend-security": {
			"description": "Performs security audits of frontend and Next.js codebases with Chrome DevTools",
			"mode": "subagent",
			"temperature": 0.1,
			"tools": {
				"write": false,
				"edit": false,
				"bash": false,
				"chrome-devtools*": true
			},
			"permissions": {
				"edit": "deny",
				"bash": {
					"*": "deny",
					"grep *": "allow",
					"find *": "allow",
					"ls *": "allow",
					"cat *": "allow"
				}
			},
			"prompt": "{file:./prompts/frontend-security.txt}"
		}
	}
}
